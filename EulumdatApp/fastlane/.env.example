# Copy to `.env` (git-ignored) and fill in. fastlane auto-loads fastlane/.env.
#
# From App Store Connect → Users and Access → Integrations → App Store Connect API:
ASC_KEY_ID=PMUP6Q569F
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000   # the Issuer ID UUID
# Optional — defaults to ~/.appstoreconnect/AuthKey_${ASC_KEY_ID}.p8
# ASC_KEY_PATH=/Users/you/.appstoreconnect/AuthKey_PMUP6Q569F.p8

# Optional Apple ID (used only for a few metadata calls; API key covers uploads):
FASTLANE_APPLE_ID=trahe@mac.com
# ASC_TEAM_ID=
