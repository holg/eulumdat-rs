# Fastfile for Eulumdat — iOS + macOS TestFlight uploads via App Store Connect API key.
#
# Auth uses the .p8 API key (no Apple ID password / 2FA needed). Configure via
# environment variables (see fastlane/.env.example):
#   ASC_KEY_ID       e.g. PMUP6Q569F
#   ASC_ISSUER_ID    the UUID from App Store Connect → Users and Access → Integrations
#   ASC_KEY_PATH     defaults to ~/.appstoreconnect/AuthKey_<ASC_KEY_ID>.p8
#
# Usage:
#   cd EulumdatApp
#   bundle exec fastlane beta            # both platforms to TestFlight
#   bundle exec fastlane beta platform:ios
#   bundle exec fastlane beta platform:mac

default_platform(:ios)

PROJECT = "EulumdatApp.xcodeproj"
SCHEME  = "EulumdatApp"

# Build an App Store Connect API token from the .p8 key + env vars.
def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID")
  issuer = ENV.fetch("ASC_ISSUER_ID")
  key_path = ENV["ASC_KEY_PATH"] || File.expand_path("~/.appstoreconnect/AuthKey_#{key_id}.p8")
  UI.user_error!("API key not found at #{key_path}") unless File.exist?(key_path)
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer,
    key_filepath: key_path,
    in_house: false
  )
end

platform :ios do
  desc "Build and upload the iOS build to TestFlight"
  lane :beta do
    key = asc_api_key
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "Eulumdat-iOS.ipa",
      clean: true
    )
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :mac do
  desc "Build and upload the macOS build to TestFlight"
  lane :beta do
    key = asc_api_key
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "Eulumdat-macOS.pkg",
      clean: true
    )
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true
    )
  end
end

# `fastlane beta` with no platform → do iOS then macOS.
lane :beta do
  Fastlane::LaneManager.cruise_lane("ios", "beta")
  Fastlane::LaneManager.cruise_lane("mac", "beta")
end
